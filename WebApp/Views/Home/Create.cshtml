@using WebApp.ViewModels;
@model HomeCreateViewModel;
@{
    ViewData["Title"] = "Nuevo proyector";
}

<div class="container">
    <h1 class="display-5 mb-3">Nuevo proyector</h1>
    <div class="row">
        <form method="post" asp-controller="Home" asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.Marca">Marca del proyector:</label>
                    <input type="text" class="form-control" asp-for="ProyectorInsertDto.Marca" />
                    <span asp-validation-for="ProyectorInsertDto.Marca" class="text-danger"></span>
                </div>

                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.Modelo">Modelo:</label>
                    <input type="text" class="form-control" asp-for="ProyectorInsertDto.Modelo" />
                    <span asp-validation-for="ProyectorInsertDto.Modelo" class="text-danger"></span>
                </div>

                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.NumeroDeSerie">Número de serie:</label>
                    <input type="text" class="form-control" asp-for="ProyectorInsertDto.NumeroDeSerie" />
                    <span asp-validation-for="ProyectorInsertDto.NumeroDeSerie" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.FechaDeAlta">Fecha de alta:</label>
                    <input type="date" class="form-control" asp-for="ProyectorInsertDto.FechaDeAlta" />
                    <span asp-validation-for="ProyectorInsertDto.FechaDeAlta" class="text-danger"></span>
                </div>

                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.Situacion">Situación del proyector:</label>
                    <select class="form-select" asp-for="ProyectorInsertDto.Situacion">
                        <option value="1">Bueno</option>
                        <option value="2">Regular</option>
                        <option value="3">Malo</option>
                    </select>
                    <span asp-validation-for="ProyectorInsertDto.Situacion" class="text-danger"></span>
                </div>

                <div class="col form-group mb-3">
                    <label class="form-label" asp-for="ProyectorInsertDto.DepartamentoId">Departamento:</label>
                    <select class="form-select" asp-for="ProyectorInsertDto.DepartamentoId">
                        <option value="">--- Seleccione una opción ---</option>
                        @foreach (var departamento in Model.Departamentos)
                        {
                            <option value="@departamento.Id">@departamento.Titulo</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group mb-3">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>